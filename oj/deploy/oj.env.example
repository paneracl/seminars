# Copy to /etc/oj/oj.env, fill in, then: chmod 600 /etc/oj/oj.env
# systemd reads this file; every value is a plain string, no quotes needed.

OJ_DEBUG=0

# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
OJ_SECRET_KEY=CHANGE_ME

OJ_ALLOWED_HOSTS=judge.cmscoinformatics.org
OJ_CSRF_ORIGINS=https://judge.cmscoinformatics.org

OJ_DB=postgres
OJ_DB_NAME=oj
OJ_DB_USER=oj
OJ_DB_PASSWORD=CHANGE_ME
OJ_DB_HOST=127.0.0.1
OJ_DB_PORT=5432

OJ_PROBLEM_ROOT=/srv/oj/problems
OJ_STATIC_ROOT=/srv/oj/static
# Uploaded statement PDFs. Served through Django so contest access rules
# apply -- do not add an nginx alias for this directory.
OJ_MEDIA_ROOT=/srv/oj/media
OJ_TIME_ZONE=Asia/Nicosia

# Judging. On a host that already runs CMS, both of these matter:
#   OJ_ISOLATE     -- reuse CMS's binary, never install a second one
#   OJ_BOX_OFFSET  -- keep our sandbox ids away from CMS's
OJ_SANDBOX=isolate
OJ_ISOLATE=/usr/local/bin/isolate
OJ_BOX_OFFSET=100
OJ_JUDGE_INLINE=0

OJ_SUBMIT_COOLDOWN=10
OJ_SUBMIT_HOURLY_CAP=60

# Run Code (compile+run on custom input, ungraded). Its own tight limits.
OJ_RUN_PER_MINUTE=6
OJ_RUN_HOURLY_CAP=80
OJ_MAX_RUN_INPUT_BYTES=65536

# Login brute-force protection (django-axes)
OJ_LOGIN_FAILURE_LIMIT=8
OJ_LOGIN_COOLOFF_HOURS=0.25
OJ_BIND=127.0.0.1:8010

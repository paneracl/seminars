[Unit]
Description=Online judge web (gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=oj
Group=oj
WorkingDirectory=/srv/oj/app/web
EnvironmentFile=/etc/oj/oj.env
ExecStart=/srv/oj/venv/bin/gunicorn -c /srv/oj/app/deploy/gunicorn.conf.py ojsite.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

# The web tier never runs untrusted code, so it can be locked down hard.
# The judge workers deliberately are not: isolate needs privileges these
# options would take away.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/oj
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
